Q1 Write a Python program to check if a given date is valid. If the date is valid, print the next day's date (incremented date). If the date is invalid, print "Invalid Date".


day = int(input())
month = int(input())
year = int(input())

def is_leap_year(y):
    return (y % 400 == 0) or (y % 4 == 0 and y % 100 != 0)


if year <= 0:
    print("Invalid Date")
else:
    
    if month < 1 or month > 12:
        print("Invalid Date")
    else:
        if month in [1, 3, 5, 7, 8, 10, 12]:
            max_days = 31
        elif month in [4, 6, 9, 11]:
            max_days = 30
        else:  
            max_days = 29 if is_leap_year(year) else 28

        
        if day < 1 or day > max_days:
            print("Invalid Date")
        else:
           
            day += 1
            if day > max_days:
                day = 1
                month += 1
                if month > 12:
                    month = 1
                    year += 1

           
            print(f"{day:02d}-{month:02d}-{year}")




Q2 Write a Python program to calculate the factorial of a number 
 using loops.
n = int(input())

factorial = 1
for i in range(1, n + 1):
    factorial *= i

print(factorial)






